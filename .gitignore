/target
**/*.rs.bk
*.pdb

# Downloaded model weights are external files, never committed.
/models

# Prebuilt sherpa-onnx native archive, fetched out-of-band (design.md §7.2).
# Large binary, regenerable; not committed. See .cargo/config.toml.
.sherpa-onnx-libs/

# Frontend build artefacts and dependencies. The source under
# crates/verse-app/ui/src is committed; none of this is.
node_modules/
/crates/verse-app/ui/dist

# Generated by create-vite, not used here.
/crates/verse-app/ui/.vscode

# Tauri's build script writes JSON schemas here on every build. They are
# derived from tauri.conf.json and the capability files, which are tracked.
/crates/verse-app/gen

# The icon's rendered form, regenerated by tools/make-icon.mjs. The script is
# the source; this is its output. The platform set under
# crates/verse-app/icons is committed because the build needs it and does not
# regenerate it.
/tools/verse-icon.png
