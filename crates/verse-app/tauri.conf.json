{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verse",
  "version": "0.1.0",
  "identifier": "dev.verse.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "ui",
      "script": "npm run dev"
    },
    "devUrl": "http://127.0.0.1:17321",
    "beforeBuildCommand": {
      "cwd": "ui",
      "script": "npm run build"
    },
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Verse",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "licences/THIRD_PARTY_NOTICES.md",
      "../../licences/FunASR-Model-License-1.1.txt": "licences/FunASR-Model-License-1.1.txt",
      "../../licences/Silero-VAD-MIT.txt": "licences/Silero-VAD-MIT.txt",
      "../../licences/sherpa-onnx-Apache-2.0.txt": "licences/sherpa-onnx-Apache-2.0.txt",
      "../../licences/LGPL-3.0.txt": "licences/LGPL-3.0.txt",
      "../../licences/GPL-3.0.txt": "licences/GPL-3.0.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
